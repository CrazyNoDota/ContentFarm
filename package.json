{
  "name": "contentfarm",
  "version": "0.1.0",
  "private": true,
  "description": "Persona-driven desktop content farm for automated short-form video drafts.",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\" \"npm:start:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "start:electron": "wait-on http://127.0.0.1:5173 dist/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "bot:kz": "tsx src/cli/run-kz-bot.ts",
    "lint": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron": "^39.2.7",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
