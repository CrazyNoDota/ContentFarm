# Optional: X official API v2 recent search.
X_BEARER_TOKEN=

# Optional: generic Threads search provider.
# The app calls: THREADS_PROVIDER_URL?query=<keyword>&limit=<n>
# Return either an array or an object with items/data/results.
THREADS_PROVIDER_URL=
THREADS_PROVIDER_API_KEY=

# Optional: OpenAI-compatible LLM endpoint for stronger script generation.
LLM_BASE_URL=https://api.openrouter.ai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=4096
# Set to off for providers that do not support OpenAI response_format.
LLM_RESPONSE_FORMAT=json_object
# Example for NVIDIA NIM / DeepSeek:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_RESPONSE_FORMAT=off
# LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}
LLM_EXTRA_BODY=

# Optional: Replicate image generation for beat visual prompts.
# Keep disabled unless you want each bot run to spend image credits.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_ENABLED=false
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-2-pro
REPLICATE_IMAGE_RESOLUTION=1 MP
REPLICATE_IMAGE_ASPECT_RATIO=9:16
REPLICATE_IMAGE_FORMAT=webp
REPLICATE_IMAGE_QUALITY=80
REPLICATE_SAFETY_TOLERANCE=2
